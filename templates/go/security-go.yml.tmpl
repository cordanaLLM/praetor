<%- /*
The trigger, draft step and later-step conditions use the hosted gate rendering shared with the
CI templates. The schedule stays because scanner advisories can change without a repository
event. internal/flavor/security_go.go selects the adopter's scanner module when it declares both
tools; all other repositories get the pinned throwaway module.
*/ -%>
---
name: Security Scan

<% hostedGateScheduledOn %>
<% hostedGateConcurrency %>
jobs:
  vulncheck:
    runs-on: ubuntu-26.04
    steps:
<% hostedGateDraftStep %>
      - name: Checkout source<% hostedGateStepIf %>
        uses: actions/checkout@v7
        with:
          persist-credentials: false
      - name: Setup Go<% hostedGateStepIf %>
        uses: actions/setup-go@v7
        with:
          go-version-file: 'go.mod'
          # See ci.yml: setup-go's cache key carries no job name, so every job
          # in the repository would share one build cache entry.
          cache: false

      # A cache key joins the runner, the go.sum hash and, for the build cache,
      # the commit, and runs past 80 columns, so yamllint's line-length rule is
      # off for the two cache steps alone.
      # yamllint disable rule:line-length
      - name: Restore Go module cache<% hostedGateStepIf %>
        uses: actions/cache@v6
        with:
          path: ~/go/pkg/mod
          key: gomod-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('**/go.sum') }}
          restore-keys: |
            gomod-${{ runner.os }}-${{ runner.arch }}-

      # `vulncheck` names this job's build cache and must differ from every
      # other job's.
      - name: Restore Go build cache<% hostedGateStepIf %>
        uses: actions/cache@v6
        with:
          path: ~/.cache/go-build
          key: gobuild-${{ runner.os }}-${{ runner.arch }}-vulncheck-${{ hashFiles('**/go.sum') }}-${{ github.sha }}
          restore-keys: |
            gobuild-${{ runner.os }}-${{ runner.arch }}-vulncheck-${{ hashFiles('**/go.sum') }}-
            gobuild-${{ runner.os }}-${{ runner.arch }}-vulncheck-
      # yamllint enable rule:line-length

      - name: Install Tools<% hostedGateStepIf %>
<% if .GoSecurity.DeclaredScanners %>        run: |
          m=tools/go/go.mod
          go install -modfile="$m" golang.org/x/vuln/cmd/govulncheck
          go install -modfile="$m" github.com/securego/gosec/v2/cmd/gosec
<% else %>        run: |
          d="$RUNNER_TEMP/scanners"
          mkdir -p "$d"
          cd "$d"
          go mod init scanners
          go get golang.org/x/vuln@<% securityGovulnVersion %>
          go get github.com/securego/gosec/v2@<% securityGosecVersion %>
          go get golang.org/x/tools@<% securityXToolsVersion %>
          go mod download all
          go install golang.org/x/vuln/cmd/govulncheck
          go install github.com/securego/gosec/v2/cmd/gosec
<% end %>      - name: Run govulncheck<% hostedGateStepIf %>
        run: govulncheck ./...
      - name: Run gosec<% hostedGateStepIf %>
        run: gosec -conf .gosec.json ./...
