<%- /*
The trigger, the draft step and every later step's condition are the hosted gate shape
(templates/hostedgate.go, defined in internal/ghworkflow/hostedgate.go): the job runs on a push to
the default branch and on every pull request activity that can change what merges, and on a draft
it fails in its first step, saying it runs when the pull request is marked ready (#817). Every
rendering this body or an earlier one produced is recorded (internal/flavor/ci_prior.go), so an
unedited copy is refreshed without --force.
*/ -%>
---
name: CI

<% hostedGateOn %>
<% hostedGateConcurrency %>
jobs:
  test:
    runs-on: ubuntu-26.04
    steps:
<% hostedGateDraftStep %>
      - name: Checkout source<% hostedGateStepIf %>
        # yamllint disable-line rule:line-length
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false

      - name: Check for pubspec.yaml<% hostedGateStepIf %>
        id: manifest
        run: |
          if [ -f pubspec.yaml ]; then
            echo "present=true" >> "$GITHUB_OUTPUT"
          else
            echo "present=false" >> "$GITHUB_OUTPUT"
            echo "::notice::Flutter steps skipped: no pubspec.yaml yet"
          fi

      - name: Setup Flutter<% hostedGateManifestStepIf %>
        # yamllint disable-line rule:line-length
        uses: subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2  # v2.23.0
        with:
          channel: stable

      - name: Install dependencies<% hostedGateManifestStepIf %>
        run: flutter pub get

      - name: Analyze<% hostedGateManifestStepIf %>
        run: flutter analyze

      - name: Test<% hostedGateManifestStepIf %>
        run: flutter test
