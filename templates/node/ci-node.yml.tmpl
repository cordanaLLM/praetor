<%- /*
Scaffolded by typescript-node only where CI's checkout supplies what each step below needs
(npmCIRequirement, internal/flavor/node_ci.go): Git tracks package-lock.json at the root or would
commit it (one that is untracked and git-ignored does not count, and outside a Git work tree the
job is withheld), package.json names npm or no packageManager, and its test script is neither
missing, blank nor the npm init placeholder. Whether the scripts themselves pass is the
repository's own code. Adoption makes the test job a required check, so a step this body adds
must need only what that requirement checks; TestNodeCIJobIsScaffoldedOnlyWhereItRunsAsWritten
fails on any command it does not model.
*/ -%>
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: lts/*
          cache: npm

      # npm ci installs exactly what package-lock.json records and fails when the two disagree.
      - name: Install dependencies
        run: npm ci

      - name: Lint
        run: npm run lint --if-present

      - name: Build
        run: npm run build --if-present

      - name: Test
        run: npm test
