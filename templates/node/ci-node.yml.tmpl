<%- /*
Scaffolded by typescript-node only where every step below can pass: the root holds
package-lock.json, package.json names npm or no packageManager, and its test script is real
(npmCIRequirement, internal/flavor/node_ci.go). Adoption makes the test job a required check,
so a step this body adds must be one that requirement guarantees; TestNodeCIJobIsScaffoldedOnlyWhereItRunsAsWritten
fails on any command it does not model.
*/ -%>
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: lts/*
          cache: npm

      # npm ci installs exactly what package-lock.json records and fails when the two disagree.
      - name: Install dependencies
        run: npm ci

      - name: Lint
        run: npm run lint --if-present

      - name: Build
        run: npm run build --if-present

      - name: Test
        run: npm test
