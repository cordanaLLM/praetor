name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '25'

      # jvm-service matches Maven and Gradle builds alike, so the step runs whichever the
      # repository carries, preferring a checked-in wrapper over the runner's own install.
      - name: Build and verify
        run: |
          if [ -x ./mvnw ]; then
            ./mvnw -B verify
          elif [ -f pom.xml ]; then
            mvn -B verify
          elif [ -x ./gradlew ]; then
            ./gradlew check
          else
            echo "no Maven or Gradle build found" >&2
            exit 1
          fi
