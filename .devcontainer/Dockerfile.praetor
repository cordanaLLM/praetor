# Praetor bootstrap v1; selected source digest sha256:1980ca72d9419a22fb1c6e3e0033d40d2e1c4e4e1fdb9666e24514eb6c23da65
FROM docker.io/library/golang@sha256:738d1cf061836894ff6bb8c33881080ac66de8cf0586615012a0c8f592649cfa AS praetor_build
WORKDIR /praetor-source
COPY ["praetor-source.000.b64", "/tmp/praetor-source/000.b64"]
COPY ["praetor-source.001.b64", "/tmp/praetor-source/001.b64"]
COPY ["praetor-source.002.b64", "/tmp/praetor-source/002.b64"]
COPY ["praetor-source.003.b64", "/tmp/praetor-source/003.b64"]
COPY ["praetor-source.004.b64", "/tmp/praetor-source/004.b64"]
COPY ["praetor-source.005.b64", "/tmp/praetor-source/005.b64"]
RUN cat /tmp/praetor-source/*.b64 > /tmp/praetor-source.b64 && base64 -d /tmp/praetor-source.b64 > /tmp/praetor-source.tar.gz
RUN echo '0ca4212a2eb4eb373d65b609fba13d773c2e4ff77bc2e54024d9616d200eabca  /tmp/praetor-source.tar.gz' > /tmp/praetor-source.sha256 && sha256sum -c /tmp/praetor-source.sha256 && tar -xzf /tmp/praetor-source.tar.gz -C /praetor-source
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org
RUN sha256sum go.mod go.sum > /tmp/praetor-modules.sha256 && /usr/local/go/bin/go mod download && /usr/local/go/bin/go mod verify && sha256sum -c /tmp/praetor-modules.sha256
RUN /usr/local/go/bin/go build -mod=readonly -trimpath -buildvcs=false -o /out/praetorctl ./cmd/standardsctl
FROM mcr.microsoft.com/devcontainers/base@sha256:0b997af705ff88f10e3293326dce61b4a9676b9f98de6aad67f1973691737dd8
COPY --from=praetor_build --chmod=0444 /praetor-source/LICENSE /usr/local/share/praetor/LICENSE
COPY --from=praetor_build --chmod=0555 /out/praetorctl /usr/local/bin/praetorctl
COPY --from=praetor_build --chmod=0555 /out/praetorctl /usr/local/bin/standardsctl
USER vscode
