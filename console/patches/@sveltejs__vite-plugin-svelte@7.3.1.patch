+			if (typeof key === 'string' && UNSAFE_MERGE_KEYS.has(key)) {
+				continue;
+			}
+			merged[key] = mergeValue(object === source ? merged[key] : undefined, object[key]);
+		}
+	}
+	return merged;
+}
