{
	"name": "praetor-console",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.8",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --config vite.preview.config.ts",
		"fixtures:copy": "node scripts/copy-fixtures.mjs build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint --max-warnings=0 .",
		"format": "prettier --write .",
		"test": "vitest run",
		"budget": "node scripts/bundle-budget.mjs build",
		"test:a11y": "playwright test",
		"test:a11y:planted": "node scripts/expect-planted-failure.mjs"
	},
	"dependencies": {
		"@sveltesentio/realtime": "0.7.0",
		"@sveltesentio/ui": "0.8.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "22.20.5",
		"ajv": "8.20.0",
		"axe-core": "4.14.0",
		"eslint": "10.13.0",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jsdom": "30.1.3",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
