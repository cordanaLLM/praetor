{
	"name": "praetor-console",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --config vite.preview.config.ts",
		"fixtures:copy": "node scripts/copy-fixtures.mjs build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint --max-warnings=0 .",
		"format": "prettier --write .",
		"test": "vitest run",
		"budget": "node scripts/bundle-budget.mjs build",
		"test:a11y": "playwright test",
		"test:a11y:planted": "node scripts/expect-planted-failure.mjs"
	},
	"dependencies": {
		"@sveltesentio/realtime": "0.8.0",
		"@sveltesentio/ui": "0.9.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.3.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "26.6.6",
		"ajv": "8.20.0",
		"axe-core": "4.14.1",
		"eslint": "10.15.0",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"jsdom": "30.1.3",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"svelte": "5.58.0",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	}
}
