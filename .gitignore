# Binaries and build artifacts
/bin/
/dist/
/site/
*.exe
*.exe~
*.dll
*.so
*.dylib
/standardsctl
/standards-mcp
/standards-lsp
/praetorctl
/praetor-mcp
/praetor-lsp
/tribunusctl

# Test and coverage artifacts
*.out
*.test
coverage.txt
coverage.html
/tmp/

# .standards-receipt.json, the Exit-0 receipt `praetorctl gate run` writes, is never committed: it
# attests the commit it was minted for, so committing it moves HEAD off that commit. The managed
# block below ignores it from v4 on (REUSE leaves VCS-ignored build artifacts out of its check);
# `praetorctl gate verify` still reads it against the receipt.public_key pinned in .standards.yaml.
# Paste it into the PR body (.github/pull_request_template.md).

# Python bytecode. The hooks run with -B so the tree normally stays clean, but any direct
# python3 invocation (a unittest run, a manual script) writes it, and `git add -A` then stages
# compiled bytes nobody reviewed.
__pycache__/
*.py[cod]

# Dependency directories
/vendor/
# Every npm project, current and future, must keep node_modules uncommittable.
node_modules/

# IDE and OS files
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
# Generated by `praetorctl editors generate` and checked by `make editors-verify`.
!.vscode/extensions.json
*.swp
*.swo
*~

# Temporary scratch and research files
*.rtf
extracted_plan.txt
plan_clean.md
all_github_repos.json
# Workflow agent worktrees
/.claude/worktrees/
/.claude/settings.local.json

# Operational configuration belongs to the operational fork, never to the public engine:
# organisation and repository names, runner routing and cluster manifests are operator
# data. The engine reads these paths when an operator supplies them locally and reports
# the capability as not configured when they are absent.
#
# This list and ownerOnlyPrefixes in internal/operationalsync/overlay.go are one contract:
# operational sync accepts operator files only under paths the engine ignores here, and a
# test replays `git check-ignore` for every prefix, so removing an entry here fails that test.
/.config/fleet.yaml
/.config/fleet-topology.yaml
/.config/orgs/
/.config/operator/
/deploy/arc/
/deploy/k8s/

# The Playwright MCP server writes page snapshots, console logs and screenshots here; they
# can show private pages, so they never reach a commit.
/.playwright-mcp/

# The figure player archive GoReleaser's before hook packs for a release (.goreleaser.yaml).
/.release-extra/

# BEGIN praetor private artifacts (praetorctl adopt)
.workingdir/
.workingdir2/
/.standards/worktrees/
/.agents/mcp_config.json
/.standards/cache/
/.claude/settings.local.json
/.standards-receipt.json
# END praetor private artifacts
