# Binaries and build artifacts
/bin/
/dist/
/site/
*.exe
*.exe~
*.dll
*.so
*.dylib
/standardsctl
/standards-mcp
/standards-lsp
/praetorctl
/praetor-mcp
/praetor-lsp

# Test and coverage artifacts
*.out
*.test
coverage.txt
coverage.html
/tmp/

# .standards-receipt.json is deliberately NOT ignored: the Exit-0 receipt is the tracked
# evidence that `praetorctl gate run` passed for a commit, and `praetorctl gate verify`
# checks it against the receipt.public_key pinned in .standards.yaml.

# Python bytecode. The hooks run with -B so the tree normally stays clean, but any direct
# python3 invocation (a unittest run, a manual script) writes it, and `git add -A` then stages
# compiled bytes nobody reviewed.
__pycache__/
*.py[cod]

# Isolated gate/test worktrees (created by `praetorctl gate run`, removed afterwards;
# ignored so a failed cleanup cannot pollute the next scan).
/.standards/worktrees/

# Dependency directories
/vendor/

# IDE and OS files
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~

# Temporary scratch and research files
*.rtf
extracted_plan.txt
plan_clean.md
all_github_repos.json
# Private workstation state, cluster connection guides, memory and scratch.
# Publish explicitly reviewed, sanitized documentation under docs/ instead.
/.workingdir/

# Antigravity workspace MCP configuration: written per host by
# `praetorctl clients apply --client agy`, it carries absolute host paths.
/.agents/mcp_config.json

# Workflow agent worktrees
/.claude/worktrees/

# Operational configuration belongs to the operational fork, never to the public engine:
# organisation and repository names, runner routing and cluster manifests are operator
# data. The engine reads these paths when an operator supplies them locally and reports
# the capability as not configured when they are absent.
#
# This list and ownerOnlyPrefixes in internal/operationalsync/overlay.go are one contract:
# operational sync accepts operator files only under paths the engine ignores here, and a
# test replays `git check-ignore` for every prefix, so removing an entry here fails that test.
/.config/fleet.yaml
/.config/fleet-topology.yaml
/.config/orgs/
/.config/operator/
/deploy/arc/
/deploy/k8s/
