{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.config/agent/hooks/codex_pre_tool.py\"",
            "commandWindows": "(for /f \"delims=\" %r in ('git rev-parse --show-toplevel') do @python3 -B \"%r/.config/agent/hooks/codex_pre_tool.py\") || exit 2",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.config/agent/hooks/praetor_hook.py\" codex pre-dispatch",
            "commandWindows": "(for /f \"delims=\" %r in ('git rev-parse --show-toplevel') do @python3 -B \"%r/.config/agent/hooks/praetor_hook.py\" codex pre-dispatch) || exit 2",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.config/agent/hooks/checkpoint.py\"",
            "commandWindows": "(for /f \"delims=\" %r in ('git rev-parse --show-toplevel') do @python3 -B \"%r/.config/agent/hooks/checkpoint.py\") || exit 2",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.config/agent/hooks/praetor_hook.py\" codex post-return",
            "commandWindows": "(for /f \"delims=\" %r in ('git rev-parse --show-toplevel') do @python3 -B \"%r/.config/agent/hooks/praetor_hook.py\" codex post-return) || exit 2",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.config/agent/hooks/praetor_hook.py\" codex stop",
            "commandWindows": "(for /f \"delims=\" %r in ('git rev-parse --show-toplevel') do @python3 -B \"%r/.config/agent/hooks/praetor_hook.py\" codex stop) || exit 2",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
