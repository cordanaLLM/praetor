{
  "[go]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    },
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  "go.useLanguageServer": true,
  "standards.lsp.enabled": true,
  "standards.lsp.path": "${workspaceFolder}/bin/praetor-lsp",
  "standards.lsp.trace.server": "messages",
  "standards.mcp.enabled": true,
  "standards.mcp.path": "${workspaceFolder}/bin/praetor-mcp",
  "standards.modelTier": "gemini-2.5-pro",
  "standards.sentinel.headroomMB": 1024
}
