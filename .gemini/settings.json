{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B .config/agent/hooks/command_guard.py",
            "timeout": 15000
          }
        ]
      },
      {
        "matcher": "^(replace|write_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B .config/agent/hooks/checkpoint_scope.py",
            "timeout": 15000
          }
        ]
      },
      {
        "matcher": "^invoke_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.config/agent/hooks/praetor_hook.py\" gemini pre-dispatch",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B .config/agent/hooks/checkpoint.py",
            "timeout": 60000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B .config/agent/hooks/checkpoint.py",
            "timeout": 60000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "praetor-dev": {
      "command": "python3",
      "args": [
        "scripts/dev_mcp.py",
        "serve"
      ],
      "timeout": 120000
    }
  }
}
