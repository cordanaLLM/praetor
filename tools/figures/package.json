{
  "name": "@cordanallm/praetor-figures",
  "version": "1.0.0",
  "private": true,
  "description": "Renders interactive documentation figures with the vendored interfig engine, and bundles their player",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs build",
    "bundle": "node bundle.mjs",
    "check": "node build.mjs check",
    "smoke": "node smoke.mjs",
    "test": "node --test figures.test.mjs checks.test.mjs astro.test.mjs smoke.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satteri": "0.11.5",
    "typescript": "7.0.2"
  }
}
