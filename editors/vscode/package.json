{
  "name": "standards-vscode",
  "displayName": "cordanaLLM Standards & Fleet Governance",
  "description": "Praetor CLI integration, LSP support and shared agent MCP configuration for VS Code-compatible editors",
  "version": "1.0.0",
  "publisher": "cordanaLLM",
  "license": "EUPL-1.2",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:go",
    "workspaceContains:.standards.yaml",
    "workspaceContains:AGENTS.md",
    "onCommand:standards.setupAgents"
  ],
  "contributes": {
    "commands": [
      {
        "command": "standards.audit",
        "title": "Standards: Audit Repository Invariants",
        "category": "Standards"
      },
      {
        "command": "standards.compileContext",
        "title": "Standards: Compile Context (AGENTS.md)",
        "category": "Standards"
      },
      {
        "command": "standards.runGC",
        "title": "Standards: Run Verification",
        "category": "Standards"
      },
      {
        "command": "standards.checkSentinel",
        "title": "Standards: Check Sentinel Host Headroom",
        "category": "Standards"
      },
      {
        "command": "standards.setupAgents",
        "title": "Standards: Prepare Agent MCP Configuration",
        "category": "Standards"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "standards.mcp",
        "label": "Praetor Standards",
        "when": "isWorkspaceTrusted && config.standards.mcp.enabled && workspaceFolderCount > 0"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "cordanaLLM Standards Configuration",
      "properties": {
        "standards.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable standards-lsp language server daemon for real-time HISS invariant checking."
        },
        "standards.lsp.path": {
          "type": "string",
          "default": "${workspaceFolder}/bin/standards-lsp",
          "description": "LSP executable for the selected trusted workspace; never started in Restricted Mode."
        },
        "standards.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "messages",
          "description": "LSP trace communication level."
        },
        "standards.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer the workspace standards-mcp server to VS Code chat through the MCP server definition provider; trusted workspaces only."
        },
        "standards.mcp.path": {
          "type": "string",
          "default": "${workspaceFolder}/bin/standards-mcp",
          "description": "MCP server executable for the selected trusted workspace; an absolute path is offered only when the file exists. Never started in Restricted Mode."
        },
        "standards.sentinel.headroomMB": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "maximum": 1073741824,
          "description": "Free host RAM in MiB that Standards: Check Sentinel Host Headroom requires; praetorctl sentinel --min-free-mb measures it."
        },
        "standards.cli.path": {
          "type": "string",
          "default": "praetorctl",
          "scope": "machine",
          "description": "Absolute Praetor CLI path or PATH command; executed without a shell."
        },
        "standards.verificationTimeoutSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 10,
          "maximum": 600,
          "scope": "machine",
          "description": "Timeout for explicit repository verification; expiration is reported as incomplete."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test dist/*.test.js",
    "test:host": "npm run compile && node scripts/host-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.125.0",
    "typescript": "5.9.3"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read-only browsing is available; commands and subprocesses require Workspace Trust.",
      "restrictedConfigurations": [
        "standards.cli.path",
        "standards.lsp.path",
        "standards.mcp.path"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Praetor invokes local tools on the selected extension host filesystem."
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
