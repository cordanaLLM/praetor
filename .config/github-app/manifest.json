{
  "name": "cordana-standards",
  "url": "https://standards.cordana.ai",
  "hook_attributes": {
    "url": "https://standards.cordana.ai/webhooks/github",
    "active": true
  },
  "redirect_url": "https://standards.cordana.ai/auth/callback",
  "description": "Autonomous governance bot enforcing HISS invariants, semantic merge conflict resolution, and fleet configuration reconciliation across cordanaLLM repositories.",
  "public": false,
  "default_permissions": {
    "checks": "write",
    "contents": "write",
    "issues": "write",
    "metadata": "read",
    "pull_requests": "write",
    "repository_rules": "write",
    "statuses": "write",
    "workflows": "write"
  },
  "default_events": [
    "pull_request",
    "push",
    "check_suite",
    "check_run",
    "workflow_run"
  ]
}

