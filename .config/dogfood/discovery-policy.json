{
  "version": 1,
  "rules": [
    {
      "key": "hiss:go",
      "title": "Go HISS scanner dispatch",
      "kind": "scanner_extension",
      "matches": [
        ".go"
      ],
      "analyzer": "hiss"
    },
    {
      "key": "hiss:rust",
      "title": "Rust HISS scanner dispatch",
      "kind": "scanner_extension",
      "matches": [
        ".rs"
      ],
      "analyzer": "hiss"
    },
    {
      "key": "hiss:python",
      "title": "Python HISS scanner dispatch",
      "kind": "scanner_extension",
      "matches": [
        ".py"
      ],
      "analyzer": "hiss"
    },
    {
      "key": "hiss:native",
      "title": "Native HISS scanner dispatch",
      "kind": "scanner_extension",
      "matches": [
        ".c",
        ".cc",
        ".cpp",
        ".h",
        ".hpp"
      ],
      "analyzer": "hiss"
    },
    {
      "key": "hiss:typescript",
      "title": "TypeScript HISS scanner dispatch",
      "kind": "scanner_extension",
      "matches": [
        ".ts",
        ".tsx",
        ".mts"
      ],
      "analyzer": "hiss"
    },
    {
      "key": "needs:javascript",
      "title": "JavaScript needs analyzer",
      "kind": "needs_marker",
      "matches": [
        "package.json"
      ],
      "analyzer": "typescript"
    },
    {
      "key": "needs:java",
      "title": "Java needs analyzer",
      "kind": "needs_marker",
      "matches": [
        "pom.xml",
        "build.gradle",
        "build.gradle.kts"
      ],
      "analyzer": "java"
    },
    {
      "key": "needs:dotnet",
      "title": ".NET needs analyzer",
      "kind": "needs_marker",
      "matches": [
        "*.csproj",
        "*.sln"
      ],
      "analyzer": "dotnet"
    },
    {
      "key": "needs:php",
      "title": "PHP needs analyzer",
      "kind": "needs_marker",
      "matches": [
        "composer.json"
      ],
      "analyzer": "php"
    },
    {
      "key": "needs:ruby",
      "title": "Ruby needs analyzer",
      "kind": "needs_marker",
      "matches": [
        "Gemfile"
      ],
      "analyzer": "ruby"
    },
    {
      "key": "needs:scala",
      "title": "Scala needs analyzer",
