    {
      "key": "needs:swift",
      "title": "Swift needs analyzer",
      "kind": "needs_marker",
      "matches": [
        "Package.swift"
      ],
      "analyzer": "swift"
    },
    {
      "key": "needs:dart",
      "title": "Dart needs analyzer",
      "kind": "needs_marker",
