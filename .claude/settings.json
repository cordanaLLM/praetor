{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-B",
              "${CLAUDE_PROJECT_DIR}/.config/agent/hooks/command_guard.py"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-B",
              "${CLAUDE_PROJECT_DIR}/.config/agent/hooks/checkpoint_scope.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-B",
              "${CLAUDE_PROJECT_DIR}/.config/agent/hooks/checkpoint.py"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-B",
              "${CLAUDE_PROJECT_DIR}/.config/agent/hooks/checkpoint.py"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
