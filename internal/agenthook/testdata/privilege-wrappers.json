{
  "commands": [
    "env --argv0 tool",
    "env -a tool",
    "env --env0-from names",
    "env --unset NAME",
    "env -u NAME",
    "env --chdir /srv",
    "env -C /srv",
    "nice --adjustment 5",
    "nice -n 5",
    "ionice --class 2 --classdata 4",
    "ionice -c 2 -n 4",
    "chrt --sched-runtime 1000 --sched-period 2000 --sched-deadline 2000 1",
    "chrt -T 1000 -P 2000 -D 2000 1",
    "taskset --cpu-list 0",
    "taskset -c 0",
    "timeout --kill-after 2 --signal TERM 5",
    "timeout -k 2 -s TERM 5",
    "stdbuf --input 0 --output L --error L",
    "stdbuf -i 0 -o L -e L",
    "stdbuf --input=0 --output=L --error=L",
    "stdbuf -i0 -oL -eL",
    "xargs --process-slot-var SLOT",
    "xargs --max-lines 1",
    "xargs -L 1",
    "xargs --replace",
    "xargs -i",
    "xargs --eof",
    "xargs -e",
    "xargs -l",
    "setsid --fork --wait",
    "setsid -f -w",
    "nohup",
    "time --format format --output output",
    "time -f format -o output",
    "command -p",
    "builtin",
    "exec -a alias",
    "chrt --other",
    "chrt -o",
    "chrt --batch",
    "flock --timeout 2 lock",
    "systemd-run --property MemoryHigh=8G",
    "env --argv0 -tool",
    "time --output -file",
    "exec -a -alias"
  ],
  "data_only": [
    "env --argv0 sudo praetorctl conform /srv/dev",
    "time --format sudo praetorctl conform /srv/dev",
    "xargs --process-slot-var sudo praetorctl conform /srv/dev",
    "exec -a sudo praetorctl conform /srv/dev"
  ]
}
