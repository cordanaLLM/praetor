[
  {"id": "f1-continuation-before-fd", "command": "cat <<'EOF' \\\n2> /dev/null | sh\ngit commit -n -m x\nEOF"},
  {"id": "f1-continuation-inside-fd", "command": "cat <<'EOF' 2\\\n> /dev/null | sh\ngit commit -n -m x\nEOF"},
  {"id": "f2-env-continuation-indent", "command": "env \\\n  bash -c \"$(cat <<'EOF'\ngit commit -n -m x\nEOF\n)\""},
  {"id": "f2-false-refusal-continued-reader", "expect": "allow", "command": "<<'EOF' \\\n  cat > notes.txt\nO'Brien <draft>\nEOF"},
  {"id": "f3-substitution-herestring", "command": "$(cat <<< 'git commit -n -m x')"},
  {"id": "f3-substitution-split-quote", "command": "$(cat <<< 'git commit --no-''verify -m x')"},
  {"id": "f3-substitution-heredoc", "command": "$(cat <<'EOF'\ngit commit -n -m x\nEOF\n)"},
  {"id": "f3-shell-variable", "command": "\"$SHELL\" -c \"$(cat <<< 'git commit -n -m x')\""},
  {"id": "f3-command-wrapper", "command": "command bash -c \"$(cat <<< 'git commit -n -m x')\""},
  {"id": "f3-commit-argument", "command": "git commit \"$(cat <<< '-n')\" -m x"},
  {"id": "f4-subshell-herestring", "command": "(cat <<< 'git commit -n -m x') | sh"},
  {"id": "f4-subshell-heredoc", "command": "(cat <<'EOF'\ngit commit -n -m x\nEOF\n) | sh"},
  {"id": "f4-brace-group", "command": "{ :; cat <<< 'git commit -n -m x'; } | sh"},
  {"id": "f5-env-brace", "command": "env git {commit,-n} -m msg"},
  {"id": "f5-env-brace-all", "command": "env {git,commit,-n,-m,msg}"},
  {"id": "f5-quoted-git", "command": "'git' {commit,-n} -m msg"},
  {"id": "f5-escaped-git", "command": "\\git {commit,-n} -m msg"},
  {"id": "f6-outer-unquoted-join", "command": "bash <<OUTER\ncat <<'EOF'\nE\\\nOF\ngit commit -n -m x\nEOF\nOUTER"},
  {"id": "control-data-file", "expect": "allow", "command": "cat > notes.txt <<'EOF'\ngit commit -n -m x\nEOF"},
  {"id": "control-message-substitution", "expect": "allow", "command": "git commit -m \"$(cat <<'EOF'\nsubject\n\nbody names --no-verify and git commit -n as text\nEOF\n)\""},
  {"id": "control-message-stdin", "expect": "allow", "command": "git commit -F - <<'EOF'\nsubject\n\nbody names git commit -n as text\nEOF"},
  {"id": "control-shell-heredoc", "command": "bash <<'EOF'\ngit commit -n -m x\nEOF"},
  {"id": "control-pipe-shell", "command": "cat <<'EOF' | sh\ngit commit -n -m x\nEOF"},
  {"id": "control-plain", "command": "git commit -n -m x"},
  {"id": "control-continued-data-payload", "expect": "allow", "command": "<<'EOF' \\\n  cat > notes.txt\ngit commit -n -m x\nEOF"},
  {"id": "control-echo-braces", "expect": "allow", "command": "echo {a,b}"},
  {"id": "control-find-braces", "expect": "allow", "command": "find . -exec gofmt -l {} +"},
  {"id": "control-mkdir-braces", "expect": "allow", "command": "mkdir -p out/{a,b}"},
  {"id": "control-inline-braces-switch", "expect": "allow", "command": "git commit -m 'message names {} and --no-verify as text'"},
  {"id": "control-message-wrapper", "command": "command git commit -m \"$(cat <<'EOF'\ngit commit -n -m x\nEOF\n)\""},
  {"id": "control-message-multiple-readers", "command": "git commit -m \"$(cat <<'EOF'\ngit commit -n -m x\nEOF\ncat /dev/null)\""},
  {"id": "f5-absolute-env-brace", "command": "/usr/bin/env git {commit,-n} -m msg"},
  {"id": "f5-absolute-env-brace-all", "command": "/usr/bin/env {git,commit,-n,-m,msg}"},
  {"id": "unmodeled-reader-function", "command": "cat() (bash); cat <<'EOF'\ngit commit -n -m x\nEOF"},
  {"id": "unmodeled-spaced-reader-function", "command": "cat () (bash); cat <<'EOF'\ngit commit -n -m x\nEOF"},
  {"id": "outer-unquoted-execution", "command": "bash <<OUTER\ncat <<'EOF'\n$(git commit -n -m x)\nEOF\nOUTER"},
  {"id": "outer-unquoted-expanded-delimiter", "command": "bash <<OUTER\ncat <<'EOF'\n$(cat <<< EOF)\ngit commit -n -m x\nEOF\nOUTER"},
  {"id": "outer-unquoted-escaped-pair", "command": "bash <<OUTER\ncat <<EOF\nE\\\\\nOF\ngit commit -n -m x\nEOF\nOUTER"},
  {"id": "outer-unquoted-escaped-option", "command": "bash <<OUTER\ngit commit \\\\-n -m x\nOUTER"},
  {"id": "outer-unquoted-nested-data", "command": "bash <<OUTER\ncat <<'D1'\ncat <<'D2'\n$(cat <<< D1)\ngit commit -n -m x\nD2\nD1\nOUTER"}
]
