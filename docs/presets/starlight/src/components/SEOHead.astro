---
// Starlight `Head` override, registered as `components.Head` in astro.config.mjs.
// It renders Starlight's default head first, so the title, description, canonical link,
// OpenGraph and Twitter tags, sitemap link and every `head` entry from the config and
// frontmatter stay exactly as Starlight emits them. It then adds one per-page Schema.org
// TechArticle, which the site-wide `head` config cannot express because its headline and
// URL differ on every page.
//
// Starlight 0.32+ passes route data through Astro.locals.starlightRoute, not Astro.props.
import Default from '@astrojs/starlight/components/Head.astro';
import config from 'virtual:starlight/user-config';

const { entry, lang, lastUpdated } = Astro.locals.starlightRoute;
const { data } = entry;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const techArticle = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: data.title,
  description: data.description || config.description,
  ...(canonical ? { url: canonical } : {}),
  ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
  inLanguage: lang,
  proficiencyLevel: 'Expert',
  author: {
    '@type': 'Organization',
    name: 'cordanaLLM',
    url: 'https://standards.cordana.ai',
  },
};
---

<Default />
<script type="application/ld+json" set:html={JSON.stringify(techArticle)} />
