---
// Starlight `Head` override, registered as `components.Head` in astro.config.mjs.
// It renders Starlight's default head first, so the title, description, canonical link,
// OpenGraph and Twitter tags, sitemap link and every `head` entry from the config and
// frontmatter stay exactly as Starlight emits them. It then adds one per-page Schema.org
// TechArticle, which the site-wide `head` config cannot express because its headline and
// URL differ on every page.
//
// Starlight 0.32+ passes route data through Astro.locals.starlightRoute, not Astro.props.
//
// dateModified is required (`praetorctl seo audit dist` fails a TechArticle without it).
// Starlight fills lastUpdated only when its `lastUpdated` option is on or the page's
// frontmatter sets one; otherwise the build time stands in, the same fallback the MkDocs
// preset uses (page.update_date).
//
// author is the site title from astro.config.mjs (`siteTitle`, localized per page), since
// Starlight has no author option: the site that renders this component names itself, and
// the component names no project of its own. Schema.org accepts a text string where it
// expects a Person or Organization (https://schema.org/docs/datamodel.html), and so does the
// `praetorctl seo audit` author check.
import Default from '@astrojs/starlight/components/Head.astro';
import config from 'virtual:starlight/user-config';

const { entry, lang, lastUpdated, siteTitle } = Astro.locals.starlightRoute;
const { data } = entry;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const techArticle = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: data.title,
  description: data.description || config.description,
  ...(canonical ? { url: canonical } : {}),
  dateModified: (lastUpdated ?? new Date()).toISOString(),
  inLanguage: lang,
  proficiencyLevel: 'Expert',
  author: siteTitle,
};
---

<Default />
<script type="application/ld+json" set:html={JSON.stringify(techArticle)} />
